# ─────────────────────────────────────────────────────────────────────────────
# PARQX backend — environment configuration
#
# Copy to .env and fill in. NOTHING in this file may be committed with real values.
# Every secret listed here was previously hardcoded in server.js; all of those
# values must be treated as compromised and rotated before use.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=3000
HOST=0.0.0.0
# Comma-separated. "*" is rejected in production.
CORS_ORIGINS=*
TRUST_PROXY=true

# ── Database ────────────────────────────────────────────────────────────────
# REQUIRED. There is no fallback: the process will not start without it.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=10000
DB_STATEMENT_TIMEOUT_MS=15000

# ── Auth ────────────────────────────────────────────────────────────────────
# REQUIRED in production. Must differ from each other, min 32 chars.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
JWT_ISSUER=parqx
BCRYPT_ROUNDS=12

# ── OTP ─────────────────────────────────────────────────────────────────────
# console = print to the log (development only). msg91 = send over WhatsApp.
OTP_PROVIDER=console
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30
# MUST be false in production. The old implementation returned the OTP in the
# HTTP response body, which defeated the mechanism entirely.
OTP_EXPOSE_IN_RESPONSE=true
OTP_COUNTRY_CODE=91
MSG91_AUTH_KEY=
MSG91_WA_TEMPLATE=transactional
MSG91_WA_NAMESPACE=
MSG91_WA_NUMBER=

# ── Payments ────────────────────────────────────────────────────────────────
PAYMENTS_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Booking rules ───────────────────────────────────────────────────────────
HOLD_SECONDS=120
PENDING_PAYMENT_SECONDS=600
BOOKING_BUFFER_MINUTES=10
BOOKING_DEFAULT_DURATION_MINUTES=60
BOOKING_MIN_DURATION_MINUTES=30
BOOKING_MAX_DURATION_MINUTES=1440
BOOKING_MAX_ADVANCE_DAYS=30
BOOKING_NO_SHOW_GRACE_MINUTES=60

# ── Pricing ─────────────────────────────────────────────────────────────────
PRICING_OCCUPANCY_WEIGHT=0.2
PRICING_FORECAST_WEIGHT=0.35
PRICING_MAX_MULTIPLIER=1.8
PRICING_OVERSTAY_HALF_HOUR_PAISE=1000
PLATFORM_FEE_BPS=0

# ── Rate limiting ───────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_OTP_PER_HOUR=5
RATE_LIMIT_OTP_VERIFY_PER_HOUR=10
RATE_LIMIT_AUTH_PER_HOUR=20
RATE_LIMIT_WRITE_PER_MINUTE=60
RATE_LIMIT_READ_PER_MINUTE=240

# ── Background jobs ─────────────────────────────────────────────────────────
JOBS_ENABLED=true
JOB_HOLD_SWEEP_MS=5000
JOB_BOOKING_SWEEP_MS=30000

# ── Feature flags (rollback = flip a flag, not a redeploy) ──────────────────
FEATURE_AUTH_REQUIRED=true
FEATURE_SERVER_PAYMENT_VERIFICATION=true
FEATURE_REFUNDS_ENABLED=false
FEATURE_LEGACY_ROUTES_ENABLED=true
ENABLE_DEV_RESET=false

# ── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=debug
